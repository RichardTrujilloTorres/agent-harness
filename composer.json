{
    "name": "desemax/agent-harness",
    "description": "Scenario-based test runner for conversational agents: scripted or LLM-played users, deterministic checks, LLM judge, HTML and JUnit reports.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "testing",
        "ai",
        "agents",
        "llm",
        "chatbot",
        "pest"
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "symfony/console": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/http-client-contracts": "^3.5",
        "symfony/yaml": "^7.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57",
        "humbug/box": "^4.7",
        "icanhazstring/composer-unused": "^0.9.8",
        "justinrainbow/json-schema": "^6.14",
        "laravel/pint": "^1.32",
        "maglnet/composer-require-checker": "^4.20",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "php-standard-library/php-standard-library": "4.3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.8",
        "vimeo/psalm": "^7.6"
    },
    "replace": {
        "azjezz/psl": "4.3.0"
    },
    "suggest": {
        "pestphp/pest": "Write conversation tests in your own Pest suite with conversation() and toPassScenario()"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Desemax\\AgentHarness\\": "src/"
        },
        "files": [
            "src/Pest/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Desemax\\AgentHarness\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/agent-harness"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "arch": "pest tests/Arch",
        "audit": "@composer audit",
        "check": [
            "@commits",
            "@lint",
            "@stan",
            "@rector",
            "@taint",
            "@deps",
            "@audit",
            "@test",
            "@arch",
            "@coverage",
            "@types",
            "@mutate",
            "@schema",
            "@demo:check",
            "@phar",
            "@phar:check"
        ],
        "commits": "bash scripts/commits",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "pest --coverage --min=95"
        ],
        "demo": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8787 -t examples/demo-agent/public"
        ],
        "demo:check": "@php scripts/demo-check.php",
        "deps": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "composer-unused --no-progress",
            "composer-require-checker check --config-file=composer-require-checker.json composer.json"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=4G vendor/bin/pest --mutate --everything --covered-only --parallel --min=85"
        ],
        "phar": "@php -d phar.readonly=0 vendor/bin/box compile --no-interaction",
        "phar:check": [
            "@php build/agent-harness.phar validate examples/scenarios",
            "@php scripts/demo-check.php build/agent-harness.phar"
        ],
        "rector": "rector process --dry-run --no-progress-bar",
        "schema": "pest tests/Unit/Schema",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "taint": "psalm --taint-analysis --no-progress --no-cache",
        "test": "pest",
        "types": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
    },
    "scripts-descriptions": {
        "arch": "Architecture tests",
        "audit": "Check dependencies for security advisories",
        "check": "Every gate, in order",
        "commits": "Lint every commit message from the root commit",
        "coverage": "Tests with line coverage, at least 95 %",
        "demo": "Start the demo agent on http://127.0.0.1:8787/chat",
        "demo:check": "Run the examples against the demo agent: 4 passed, 2 failed, exit 1",
        "deps": "composer.json valid and normalized, no unused or undeclared dependencies",
        "lint": "Check code style with Pint",
        "lint:fix": "Fix code style with Pint",
        "mutate": "Mutation testing, covered mutation score at least 85 %",
        "phar": "Build build/agent-harness.phar",
        "phar:check": "Smoke test the PHAR: validate and the demo run",
        "rector": "Rector dry run: fails if Rector would change anything",
        "schema": "Check the JSON schemas against the validator, examples and fixtures",
        "stan": "PHPStan at level max with strict and deprecation rules (src, tests, bin)",
        "taint": "Psalm taint analysis",
        "test": "Run the test suite",
        "types": "Type coverage, 100 %"
    }
}
