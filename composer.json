{
    "name": "desemax/agent-harness",
    "description": "Scenario-based test harness for conversational agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.1",
        "symfony/yaml": "^7.1",
        "symfony/http-client": "^7.1"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "pestphp/pest": "Write conversation tests in your own Pest suite with conversation() and toPassScenario()"
    },
    "autoload": {
        "psr-4": {
            "Desemax\\AgentHarness\\": "src/"
        },
        "files": [
            "src/Pest/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Desemax\\AgentHarness\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/agent-harness"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
